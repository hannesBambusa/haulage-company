[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/staff_panel.gd" id="1_script"]
[ext_resource type="Theme" path="res://ui/theme/terminal_theme.tres" id="2_theme"]

[node name="StaffPanel" type="PanelContainer"]
anchors_preset = 0
offset_left = 20.0
offset_top = 120.0
offset_right = 620.0
offset_bottom = 640.0
theme = ExtResource("2_theme")
theme_type_variation = &"WindowPanel"
mouse_filter = 2
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 14

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Staff"

[node name="Hint" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 13
text = "Duty and needs per worker (F2 toggles)"

[node name="Rows" type="GridContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/h_separation = 14
theme_override_constants/v_separation = 4
columns = 5
